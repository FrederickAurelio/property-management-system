{
  "folders": [
    {
      "name": "cabin (root)",
      "path": "."
    },
    {
      "name": "api",
      "path": "apps/api"
    },
    {
      "name": "pms",
      "path": "apps/pms"
    },
    {
      "name": "web",
      "path": "apps/web"
    },
    {
      "name": "api-contract",
      "path": "packages/api-contract"
    }
  ],
  "settings": {
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "eslint.workingDirectories": [
      { "directory": "apps/api", "changeProcessCWD": true },
      { "directory": "apps/pms", "changeProcessCWD": true },
      { "directory": "apps/web", "changeProcessCWD": true }
    ],
    "eslint.useFlatConfig": true,
    "eslint.validate": [
      "javascript",
      "javascriptreact",
      "typescript",
      "typescriptreact"
    ]
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "Prisma.prisma",
      "bradlc.vscode-tailwindcss"
    ]
  }
}
