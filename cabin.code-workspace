{
  "folders": [
    {
      "name": "cabin (root)",
      "path": ".",
    },
    {
      "name": "api",
      "path": "apps/api",
      "settings": {
        "eslint.workingDirectories": [
          { "directory": ".", "changeProcessCWD": true },
        ],
      },
    },
    {
      "name": "pms",
      "path": "apps/pms",
      "settings": {
        "eslint.workingDirectories": [
          { "directory": ".", "changeProcessCWD": true },
        ],
        "prettier.configPath": "prettier.config.mjs",
        "prettier.prettierPath": "./node_modules/prettier",
        "tailwindCSS.experimental.configFile": "src/index.css",
      },
    },
    {
      "name": "web",
      "path": "apps/web",
      "settings": {
        "eslint.workingDirectories": [
          { "directory": ".", "changeProcessCWD": true },
        ],
        "prettier.configPath": "prettier.config.mjs",
        "prettier.prettierPath": "./node_modules/prettier",
        "tailwindCSS.experimental.configFile": "src/index.css",
      },
    },
    {
      "name": "api-contract",
      "path": "packages/api-contract",
    },
    {
      "name": "ui-tokens",
      "path": "packages/ui-tokens",
    },
  ],
  "settings": {
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "eslint.workingDirectories": [
      { "directory": "apps/api", "changeProcessCWD": true },
      { "directory": "apps/pms", "changeProcessCWD": true },
      { "directory": "apps/web", "changeProcessCWD": true },
    ],
    "eslint.useFlatConfig": true,
    "eslint.validate": [
      "javascript",
      "javascriptreact",
      "typescript",
      "typescriptreact",
    ],
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "tailwindCSS.experimental.configFile": {
      "apps/pms/src/index.css": "apps/pms/**",
      "apps/web/src/index.css": "apps/web/**",
    },
    "tailwindCSS.classAttributes": ["class", "className", "class:list"],
    "tailwindCSS.classFunctions": ["cva", "cn", "clsx", "twMerge"],
    "tailwindCSS.includeLanguages": {
      "typescript": "javascript",
      "typescriptreact": "javascript",
    },
    "prisma.pinToPrisma6": true,
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "Prisma.prisma",
      "bradlc.vscode-tailwindcss",
    ],
  },
}
