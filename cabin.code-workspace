{
  "folders": [
    {
      "name": "cabin",
      "path": ".",
    },
  ],
  "settings": {
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "eslint.workingDirectories": [
      { "directory": "apps/api", "changeProcessCWD": true },
      { "directory": "apps/pms", "changeProcessCWD": true },
      { "directory": "apps/web", "changeProcessCWD": true },
    ],
    "eslint.useFlatConfig": true,
    "eslint.validate": [
      "javascript",
      "javascriptreact",
      "typescript",
      "typescriptreact",
    ],
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[javascriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[typescriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/coverage": true,
      "**/.pnpm-store": true,
      "**/.impeccable": true,
    },
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/.git/objects/**": true,
      "**/coverage/**": true,
      "**/.impeccable/**": true,
    },
    "files.exclude": {
      "**/node_modules": true,
      "**/dist": true,
    },
    "tailwindCSS.experimental.configFile": {
      "apps/pms/src/index.css": "apps/pms/**",
      "apps/web/src/index.css": "apps/web/**",
    },
    "tailwindCSS.classAttributes": ["class", "className", "class:list"],
    "tailwindCSS.classFunctions": ["cva", "cn", "clsx", "twMerge"],
    "tailwindCSS.includeLanguages": {
      "typescript": "javascript",
      "typescriptreact": "javascript",
    },
    "prisma.pinToPrisma6": true,
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "Prisma.prisma",
      "bradlc.vscode-tailwindcss",
    ],
  },
}
