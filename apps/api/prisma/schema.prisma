generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  FRONT_DESK
}

enum UnitStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum UnitLayout {
  STUDIO
  APARTMENT
  CABIN
  OTHER
}

enum ReservationSource {
  MANUAL
  WEBSITE
  BOOKING_COM
  AIRBNB
  AGODA
}

enum ReservationStatus {
  UNCONFIRMED
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  DEPOSIT
  PAID
  REFUNDED
}

enum CollectedVia {
  PROPERTY
  CHANNEL
  MIXED
}

enum PaymentMovementDirection {
  IN
  OUT
}

enum PaymentMovementKind {
  DEPOSIT
  TOP_UP
  REFUND
  CANCEL_REFUND
  CHANNEL_SETTLED
}

enum IcalSyncWarning {
  MISSING_FROM_FEED
  DATES_DIFFER
  OTA_STILL_LISTED
  IMPORT_OVERLAP
  UNIT_DIFFER
}

enum CalendarBlockKind {
  MAINTENANCE
  OWNER
  HOLD
  OTHER
}

enum StayBillingPeriod {
  DAILY
  MONTHLY
  YEARLY
}

enum UtilityKind {
  ELECTRICITY
  WATER
}

/// CONSTANT = whole IDR; PERCENT = integer percent (3 = 3%, never 0.03).
enum UtilityAddonKind {
  CONSTANT
  PERCENT
}

model Admin {
  id           String    @id @default(cuid())
  username     String    @unique @db.VarChar(64)
  passwordHash String
  role         AdminRole
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reservationsCreated  Reservation[]     @relation("ReservationCreatedBy")
  reservationsUpdated  Reservation[]     @relation("ReservationUpdatedBy")
  movementsCreated     PaymentMovement[] @relation("MovementCreatedBy")
  calendarBlocksCreated CalendarBlock[]  @relation("CalendarBlockCreatedBy")
  utilityReadingsCreated ReservationUtilityReading[] @relation("UtilityReadingCreatedBy")
  maintenanceChargesCreated ReservationMaintenanceCharge[] @relation("MaintenanceChargeCreatedBy")
  adminChargesCreated ReservationAdminCharge[] @relation("AdminChargeCreatedBy")
}

/// connect-pg-simple table (exact column names)
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

model Property {
  id            String    @id @default(cuid())
  code          String    @unique @db.VarChar(32)
  name          String    @db.VarChar(128)
  timezone      String    @db.VarChar(64)
  checkInFrom   String?   @db.VarChar(5)
  checkInUntil  String?   @db.VarChar(5)
  checkOutFrom  String?   @db.VarChar(5)
  checkOutUntil String?   @db.VarChar(5)
  addressLine   String?   @db.VarChar(255)
  city          String?   @db.VarChar(128)
  countryCode   String?   @db.Char(2)
  latitude      Decimal?  @db.Decimal(10, 7)
  longitude     Decimal?  @db.Decimal(10, 7)
  googlePlaceId String?   @db.VarChar(256)
  coverImage    Json?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  unitTypes      UnitType[]
  units          Unit[]
  reservations   Reservation[]
  calendarBlocks CalendarBlock[]

  @@index([isActive])
  /// DB: Property_lat_lng_pair_check — (latitude IS NULL) = (longitude IS NULL)
}

model UnitType {
  id              String     @id @default(cuid())
  propertyId      String
  code            String     @db.VarChar(32)
  name            String     @db.VarChar(128)
  layout          UnitLayout
  sizeSqm         Decimal?   @db.Decimal(6, 2)
  bedroomCount    Int
  bathroomCount   Int        @default(1)
  maxGuests        Int
  defaultPriceIdr  Int
  monthlyPriceIdr  Int
  yearlyPriceIdr   Int
  /// Default IDR per kWh for guest electricity billing (0 = unset).
  electricityRateIdrPerKwh  Int @default(0)
  /// Default IDR per m³ for guest water billing (0 = unset).
  waterRateIdrPerM3         Int @default(0)
  /// Default monthly maintenance fee IDR (0 = unset).
  maintenanceFeeIdrPerMonth Int @default(0)
  /// Min billed kWh per electricity interval (0 = no minimum).
  electricityMinKwh         Decimal @default(0) @db.Decimal(12, 3)
  /// Default monthly admin fee IDR (0 = unset).
  adminFeeIdrPerMonth       Int @default(0)
  bedConfig        Json
  amenities       Json
  media           Json
  description     String?    @db.Text
  smokingAllowed  Boolean    @default(false)
  sortOrder       Int        @default(0)
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  property      Property               @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  units         Unit[]
  reservations  Reservation[]
  utilityAddons UnitTypeUtilityAddon[]

  @@unique([propertyId, code])
  @@index([propertyId, isActive])
  @@index([propertyId, sortOrder])
}

model UnitTypeUtilityAddon {
  id         String           @id @default(cuid())
  unitTypeId String
  utility    UtilityKind
  name       String           @db.VarChar(128)
  kind       UtilityAddonKind
  /// CONSTANT = IDR integer; PERCENT = integer percent (3 = 3%).
  value      Int
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  unitType UnitType @relation(fields: [unitTypeId], references: [id], onDelete: Cascade)

  @@index([unitTypeId, utility, sortOrder])
}

model Unit {
  id              String     @id @default(cuid())
  propertyId      String
  unitTypeId      String
  code            String     @db.VarChar(32)
  name            String?    @db.VarChar(128)
  floor           String?    @db.VarChar(16)
  status          UnitStatus @default(ACTIVE)
  notes           String?    @db.Text
  sortOrder       Int        @default(0)
  /// Secret token for public PMS → OTA .ics export URL
  icalExportToken String     @unique @db.VarChar(64)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unitType       UnitType        @relation(fields: [unitTypeId], references: [id], onDelete: Restrict)
  reservations   Reservation[]   @relation("ReservationUnit")
  calendarBlocks CalendarBlock[]
  icalFeeds      UnitIcalFeed[]
  /// Reservations where OTA feed lists this unit (UNIT_DIFFER observed target).
  icalObservedByReservations Reservation[] @relation("ReservationIcalObservedUnit")

  @@unique([propertyId, code])
  @@index([propertyId, status])
  @@index([unitTypeId])
  @@index([propertyId, unitTypeId])
}

/// OTA calendar import URL pasted by staff (one per source per unit).
model UnitIcalFeed {
  id            String            @id @default(cuid())
  unitId        String
  source        ReservationSource
  importUrl     String            @db.VarChar(2048)
  isActive      Boolean           @default(true)
  lastPulledAt  DateTime?
  lastSuccessAt DateTime?
  lastError     String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, source])
  @@index([isActive, lastPulledAt])
}

model Reservation {
  id                String             @id @default(cuid())
  propertyId        String
  unitId            String
  unitTypeId        String
  source            ReservationSource
  status            ReservationStatus
  billingPeriod     StayBillingPeriod  @default(DAILY)
  checkInDate       DateTime           @db.Date
  checkOutDate      DateTime           @db.Date
  /// Exclusive inventory busy end — gist + overlap use this, not checkOutDate.
  /// DAILY = checkOutDate; MONTHLY/YEARLY occupying = FAR (9999-12-31).
  inventoryEndDate  DateTime           @db.Date
  guestName         String             @db.VarChar(128)
  guestEmail        String?            @db.VarChar(255)
  guestPhone        String?            @db.VarChar(32)
  guestCount        Int?
  notes             String?            @db.Text
  /// Cash-facing quote = rent + utility denorms.
  totalAmountIdr    BigInt?
  /// Rent-only quote (create/edit form).
  rentAmountIdr     BigInt?
  electricityAmountIdr BigInt          @default(0)
  waterAmountIdr       BigInt          @default(0)
  maintenanceAmountIdr BigInt          @default(0)
  /// Stay-level denorm / create-time fallback. Billing uses per-period schemes.
  electricityRateIdrPerKwh  Int        @default(0)
  waterRateIdrPerM3         Int        @default(0)
  maintenanceFeeIdrPerMonth Int        @default(0)
  /// Snapshot min billed kWh (0 = no minimum). Denorm of last saved period.
  electricityMinKwh         Decimal    @default(0) @db.Decimal(12, 3)
  /// Snapshot monthly admin fee IDR. Denorm of last saved period.
  adminFeeIdrPerMonth       Int        @default(0)
  /// Frozen add-on list `{ utility, name, kind, value, sortOrder }[]`. Denorm of last period.
  utilityAddons             Json       @default("[]")
  adminAmountIdr            BigInt     @default(0)
  paidAmountIdr     BigInt             @default(0)
  paymentStatus     PaymentStatus
  collectedVia      CollectedVia?
  externalRef       String?            @db.VarChar(256)
  icalSyncWarning   IcalSyncWarning?
  icalSyncWarnedAt  DateTime?
  /// Sticky ack for OTA_STILL_LISTED — dismiss sets this; sync will not re-warn until UID leaves the feed.
  icalOtaStillListedDismissedAt DateTime?
  /// Target unit when icalSyncWarning = UNIT_DIFFER (OTA currently lists UID on this unit’s feed).
  icalObservedUnitId String?
  /// OTA check-in/out seen with UNIT_DIFFER (may also differ from local stay dates).
  icalObservedCheckInDate  DateTime? @db.Date
  icalObservedCheckOutDate DateTime? @db.Date
  /// True = UNCONFIRMED import stub that overlaps another stay/block; excluded from calendar busy + gist.
  icalOverlapHold   Boolean            @default(false)
  confirmedAt       DateTime?
  checkedInAt       DateTime?
  checkedOutAt      DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdByAdminId  String?
  updatedByAdminId  String?

  property        Property          @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit            Unit              @relation("ReservationUnit", fields: [unitId], references: [id], onDelete: Restrict)
  unitType        UnitType          @relation(fields: [unitTypeId], references: [id], onDelete: Restrict)
  icalObservedUnit Unit?            @relation("ReservationIcalObservedUnit", fields: [icalObservedUnitId], references: [id], onDelete: SetNull)
  createdByAdmin  Admin?            @relation("ReservationCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  updatedByAdmin  Admin?            @relation("ReservationUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)
  movements       PaymentMovement[]
  utilityReadings ReservationUtilityReading[]
  maintenanceCharges ReservationMaintenanceCharge[]
  adminCharges       ReservationAdminCharge[]
  utilityPeriodSchemes ReservationUtilityPeriodScheme[]

  @@index([unitId, checkInDate, checkOutDate])
  @@index([unitId, checkInDate, inventoryEndDate])
  @@index([propertyId, checkInDate, checkOutDate])
  @@index([propertyId, checkInDate, inventoryEndDate])
  @@index([propertyId, checkInDate])
  @@index([propertyId, checkOutDate])
  @@index([propertyId, status])
  @@index([source])
  @@index([icalObservedUnitId])
  @@index([createdByAdminId])
  @@index([updatedByAdminId])
}

model ReservationUtilityReading {
  id               String      @id @default(cuid())
  reservationId    String
  utility          UtilityKind
  readingDate      DateTime    @db.Date
  meterValue       Decimal     @db.Decimal(12, 3)
  /// Garage meteran proof photos (ArchiveItem[] URLs) for this reading.
  proofImages      Json        @default("[]")
  createdAt        DateTime    @default(now())
  createdByAdminId String?

  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  createdByAdmin Admin?      @relation("UtilityReadingCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@unique([reservationId, utility, readingDate])
  @@index([reservationId, utility, readingDate])
  @@index([createdByAdminId])
}

model ReservationMaintenanceCharge {
  id               String   @id @default(cuid())
  reservationId    String
  chargeDate       DateTime @db.Date
  amountIdr        BigInt
  createdAt        DateTime @default(now())
  createdByAdminId String?

  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  createdByAdmin Admin?      @relation("MaintenanceChargeCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([reservationId, chargeDate])
  @@index([createdByAdminId])
}

model ReservationAdminCharge {
  id               String   @id @default(cuid())
  reservationId    String
  chargeDate       DateTime @db.Date
  amountIdr        BigInt
  createdAt        DateTime @default(now())
  createdByAdminId String?

  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  createdByAdmin Admin?      @relation("AdminChargeCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([reservationId, chargeDate])
  @@index([createdByAdminId])
}

/// Frozen utility rate card for one billed month (1st of month).
model ReservationUtilityPeriodScheme {
  id                        String   @id @default(cuid())
  reservationId             String
  chargeDate                DateTime @db.Date
  electricityRateIdrPerKwh  Int
  waterRateIdrPerM3         Int
  maintenanceFeeIdrPerMonth Int
  electricityMinKwh         Decimal  @db.Decimal(12, 3)
  adminFeeIdrPerMonth       Int
  /// Frozen add-on list `{ utility, name, kind, value, sortOrder }[]`.
  utilityAddons             Json     @default("[]")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, chargeDate])
  @@index([reservationId, chargeDate])
}

model PaymentMovement {
  id               String                   @id @default(cuid())
  reservationId    String
  direction        PaymentMovementDirection
  kind             PaymentMovementKind
  amountIdr        BigInt
  signedAmount     BigInt
  method           CollectedVia?
  note             String?                  @db.VarChar(500)
  /// Garage receipt / transfer screenshots (ArchiveItem[]). Amounts stay append-only; this JSON is replace-set via PATCH proofs.
  proofImages      Json                     @default("[]")
  createdAt        DateTime                 @default(now())
  createdByAdminId String?

  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  createdByAdmin Admin?      @relation("MovementCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([reservationId, createdAt])
  @@index([createdAt])
  @@index([createdByAdminId])
}

model CalendarBlock {
  id               String            @id @default(cuid())
  propertyId       String
  unitId           String
  kind             CalendarBlockKind
  startDate        DateTime          @db.Date
  endDate          DateTime          @db.Date
  note             String?           @db.VarChar(500)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdByAdminId String?

  property       Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit           Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdByAdmin Admin?   @relation("CalendarBlockCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([unitId, startDate, endDate])
  @@index([propertyId, startDate])
  @@index([createdByAdminId])
  /// DB: CalendarBlock_end_after_start_check — endDate > startDate
  /// DB: CalendarBlock_unit_excl — gist exclusion on unitId + daterange
}

/// Last 5 transfer accounts used on utility-statement PDF export (Cara Pembayaran).
model UtilityStatementBankAccount {
  id            String   @id @default(cuid())
  bankName      String   @db.VarChar(128)
  accountName   String   @db.VarChar(128)
  accountNumber String   @db.VarChar(32)
  lastUsedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([bankName, accountName, accountNumber])
  @@index([lastUsedAt])
}
