{
  "name": "@cabin/api-contract",
  "version": "0.0.0",
  "private": true,
  "description": "Shared API wire contract (success/error envelope + error codes) for api, pms, and later web",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
