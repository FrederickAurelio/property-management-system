{
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  "eslint.workingDirectories": [
    { "directory": "apps/api", "changeProcessCWD": true },
    { "directory": "apps/pms", "changeProcessCWD": true },
    { "directory": "apps/web", "changeProcessCWD": true }
  ],
  "eslint.useFlatConfig": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],

  "editor.quickSuggestions": {
    "strings": true
  },

  "tailwindCSS.experimental.configFile": {
    "apps/pms/src/index.css": "apps/pms/**"
  },
  "tailwindCSS.classAttributes": ["class", "className", "class:list"],
  "tailwindCSS.classFunctions": ["cva", "cn", "clsx", "twMerge"],
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },
  "prisma.pinToPrisma6": true
}
