# Single env file for the monorepo — copy to `.env` at repo root.
# Do not put real production secrets here.
# Production: set the same keys on the server / PaaS (Railway, Render, VPS, etc.).
# Nest + Prisma CLI both load this file (no apps/api/.env).

NODE_ENV=development
PORT=3000

# --- Docker Compose (Postgres) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cabin_pms
# Host publish port — local docker-compose.dev.yml only (VPS compose does not publish 5432)
POSTGRES_PORT=5432

# --- App (same keys in every environment) ---
# Local (Nest on host): localhost. VPS compose: host must be `postgres` (Compose DNS).
# docker-compose.yml overrides DATABASE_URL for the api service; keep this for local/Prisma CLI.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cabin_pms?schema=public

# Session cookies (required)
SESSION_SECRET=replace-with-a-long-random-string

# Cookie Secure flag. Omit to follow NODE_ENV===production.
# VPS over plain HTTP (http://IP:8080 / :3050) → false. After HTTPS is in front → true.
COOKIE_SECURE=false

# Comma-separated FE origins (credentials: true). Required when NODE_ENV=production.
# Local: PMS http://localhost:5173 · web http://localhost:5174
# VPS (no TLS yet): http://YOUR_VPS_IP:8080 (pms), http://YOUR_VPS_IP:3050 (web)
# Later with HTTPS: https://pms.your.domain,https://www.your.domain
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Production: Nest sets trust proxy automatically when NODE_ENV=production
# so secure cookies work behind a reverse proxy / TLS terminator.

# PMS + web (Vite) — both use envDir = repo root.
# PMS: browser `/api/...` → Nest `/staff/...` (Vite/nginx inject audience; not on the wire).
# Web: browser `/api/...` → Nest `/public/...` on its own origin (3050 / :5174).
# Not used as a browser-side absolute base URL.
VITE_API_URL=http://localhost:3000

# First SUPER_ADMIN when Admin table is empty (VPS deploy runs seed after migrate)
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=changeme123
# Demo Skybreeze inventory — only if Property table is empty. Off by default.
# Local demo / optional: SEED_DEMO_INVENTORY=true
SEED_DEMO_INVENTORY=

# Absolute PMS origin OTAs use for .ics export (no trailing slash).
# API stays private; Vite/nginx proxy `/public/ical` → Nest `/public/ical`.
# Local: http://localhost:5173 · VPS: http://YOUR_VPS_IP:8080 · later HTTPS: https://pms.your.domain
PUBLIC_PMS_BASE_URL=http://localhost:5173

# Media storage provider: cloudinary (default / local) | cloudflare_r2 (prod)
# Local: cloudinary + CLOUDINARY_*. Prod: cloudflare_r2 + R2 vars + MEDIA_PUBLIC_BASE_URL (custom domain).
# R2 images are FE-optimized before upload; Cloudinary keeps server-side optimize (no FE resize).
MEDIA_PROVIDER=cloudinary

# Cloudinary (when MEDIA_PROVIDER=cloudinary) — console.cloudinary.com → Settings → API Keys
# Nest mints signed upload intents; secret never goes to Vite.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 (when MEDIA_PROVIDER=cloudflare_r2)
# Docs: https://developers.cloudflare.com/r2/api/s3/presigned-urls/
# Bucket CORS must allow PMS origins + PUT + Content-Type (see _docs/media-upload-strategy.md).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
# Public read base (custom domain for prod, e.g. https://media.yourdomain.com)
MEDIA_PUBLIC_BASE_URL=

# Archive storage (staff proofs / invoices) — parallel to MEDIA_*; Garage self-host.
# Local: pnpm archive:up · docs: deploy/garage/README.md · _docs/archive-storage.md
# VPS no domain: compose publishes :3900 (S3) + :3910 (GET) — use http://YOUR_VPS_IP:…
# Later HTTPS domains: close those ports; edge proxy — deploy/garage/README.md § Domain HTTPS cutover
# Inventory gallery/cover stays on MEDIA_PROVIDER — do not point MEDIA_* at Garage.
ARCHIVE_PROVIDER=garage
ARCHIVE_S3_ENDPOINT=http://127.0.0.1:3900
ARCHIVE_S3_REGION=garage
# Match GARAGE_DEFAULT_* below (compose creates the key + cabin-archive bucket).
ARCHIVE_S3_ACCESS_KEY_ID=GKaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
ARCHIVE_S3_SECRET_ACCESS_KEY=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
ARCHIVE_S3_BUCKET=cabin-archive
ARCHIVE_S3_FORCE_PATH_STYLE=true
# Public GET via archive-proxy. Local :3910 · VPS phase A: http://YOUR_VPS_IP:3910 · phase B: https://archive.yourdomain.com
ARCHIVE_PUBLIC_BASE_URL=http://127.0.0.1:3910
# PMS origins for Garage bucket CORS (comma-separated; one rule each). Run: pnpm archive:bootstrap
# Local: http://localhost:5173,http://127.0.0.1:5173
# VPS IP: http://YOUR_VPS_IP:8080
# Domain: https://pms.yourdomain.com
ARCHIVE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Garage container bootstrap (docker-compose.dev.yml / docker-compose.yml)
GARAGE_DEFAULT_ACCESS_KEY=GKaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
GARAGE_DEFAULT_SECRET_KEY=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
GARAGE_DEFAULT_BUCKET=cabin-archive
# Garage internal tokens (compose → GARAGE_* env; not in garage.toml). Prod: rotate all three.
# Generate: openssl rand -hex 32  (rpc) · openssl rand -base64 32  (admin + metrics)
GARAGE_RPC_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
GARAGE_ADMIN_TOKEN=cabin-garage-admin-token-change-me
GARAGE_METRICS_TOKEN=cabin-garage-metrics-token-change-me

# --- Request logs (Loki; Nest push + PMS /request-logs) ---
# Local: pnpm logs:up → Loki on 127.0.0.1:3100. Nest queries and pushes HTTP JSON here.
# VPS compose overrides LOKI_URL to http://loki:3100 (unpublished).
LOKI_URL=http://127.0.0.1:3100

# --- PDF convert (Gotenberg 8 LibreOffice; Nest GOTENBERG_URL) ---
# Local: pnpm gotenberg:up → 127.0.0.1:3001 (container 3000; Nest is 3000).
# VPS compose overrides GOTENBERG_URL to http://gotenberg:3000 (unpublished).
GOTENBERG_URL=http://127.0.0.1:3001

# --- Docker build mirrors (compose → Dockerfile ARG; build-time only) ---
# GHCR deploy (primary): builds run on GitHub with EMPTY mirrors — leave these blank
# on the Actions build; VPS only pulls images (mirrors unused there).
# China emergency direct rebuild on VPS (deploy-vps.direct.backup.yml):
#   1) NPM_REGISTRY=https://registry.npmmirror.com
#   2) NPM_REGISTRY=https://mirrors.cloud.tencent.com/npm/
#   3) NPM_REGISTRY=https://mirrors.huaweicloud.com/repository/npm/
# Apt: APT_MIRROR=mirrors.aliyun.com (alt: mirrors.tuna.tsinghua.edu.cn)
# Indo / Malaysia / Singapore: leave both empty.
# Dockerfiles also raise pnpm fetch-timeout/retries and lower network-concurrency for weak VPS.
APT_MIRROR=
NPM_REGISTRY=
