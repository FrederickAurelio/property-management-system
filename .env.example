# Single env file for the monorepo — copy to `.env` at repo root.
# Do not put real production secrets here.
# Production: set the same keys on the server / PaaS (Railway, Render, VPS, etc.).
# Nest + Prisma CLI both load this file (no apps/api/.env).

NODE_ENV=development
PORT=3000

# --- Docker Compose (local Postgres only) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cabin_pms
POSTGRES_PORT=5432

# --- App (same keys in every environment) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cabin_pms?schema=public

# Later (auth / CORS) — set in `.env` locally and in prod secrets:
# SESSION_SECRET=
# CORS_ORIGINS=http://localhost:5173

# Future container publish ports
# API_PORT=3000
# PMS_PORT=5173
# WEB_PORT=5174
