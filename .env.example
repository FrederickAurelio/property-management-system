# Single env file for the monorepo — copy to `.env` at repo root.
# Do not put real production secrets here.
# Production: set the same keys on the server / PaaS (Railway, Render, VPS, etc.).
# Nest + Prisma CLI both load this file (no apps/api/.env).

NODE_ENV=development
PORT=3000

# --- Docker Compose (Postgres) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cabin_pms
# Host publish port — local docker-compose.dev.yml only (VPS compose does not publish 5432)
POSTGRES_PORT=5432

# --- App (same keys in every environment) ---
# Local (Nest on host): localhost. VPS compose: host must be `postgres` (Compose DNS).
# docker-compose.yml overrides DATABASE_URL for the api service; keep this for local/Prisma CLI.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cabin_pms?schema=public

# Session cookies (required)
SESSION_SECRET=replace-with-a-long-random-string

# Cookie Secure flag. Omit to follow NODE_ENV===production.
# VPS over plain HTTP (http://IP:8080) → false. After HTTPS is in front → true.
COOKIE_SECURE=false

# Comma-separated FE origins (credentials: true). Required when NODE_ENV=production.
# Local: PMS http://localhost:5173 · web http://localhost:5174
# VPS (no TLS yet): http://YOUR_VPS_IP:8080
# Later with HTTPS: https://your.domain
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Production: Nest sets trust proxy automatically when NODE_ENV=production
# so secure cookies work behind a reverse proxy / TLS terminator.

# PMS (Vite) — apps/pms uses envDir = repo root.
# Browser `/api/...` → Nest `/staff/...` (Vite/nginx inject audience; not on the wire).
# Phase 2 web will rewrite `/api` → `/public` on its own origin — not via PMS.
# Not used as a browser-side absolute base URL.
VITE_API_URL=http://localhost:3000

# First SUPER_ADMIN when Admin table is empty (VPS deploy runs seed after migrate)
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=changeme123
# Demo Skybreeze inventory — only if Property table is empty. Off by default.
# Local demo / optional: SEED_DEMO_INVENTORY=true
SEED_DEMO_INVENTORY=

# Absolute PMS origin OTAs use for .ics export (no trailing slash).
# API stays private; Vite/nginx proxy `/public/ical` → Nest `/public/ical`.
# Local: http://localhost:5173 · VPS: http://YOUR_VPS_IP:8080 · later HTTPS: https://pms.your.domain
PUBLIC_PMS_BASE_URL=http://localhost:5173

# Cloudinary (staff media uploads) — console.cloudinary.com → Settings → API Keys
# Nest mints signed upload intents; secret never goes to Vite.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Docker build mirrors (compose → Dockerfile ARG; build-time only) ---
# GHCR deploy (primary): builds run on GitHub with EMPTY mirrors — leave these blank
# on the Actions build; VPS only pulls images (mirrors unused there).
# China emergency direct rebuild on VPS (deploy-vps.direct.backup.yml):
#   1) NPM_REGISTRY=https://registry.npmmirror.com
#   2) NPM_REGISTRY=https://mirrors.cloud.tencent.com/npm/
#   3) NPM_REGISTRY=https://mirrors.huaweicloud.com/repository/npm/
# Apt: APT_MIRROR=mirrors.aliyun.com (alt: mirrors.tuna.tsinghua.edu.cn)
# Indo / Malaysia / Singapore: leave both empty.
# Dockerfiles also raise pnpm fetch-timeout/retries and lower network-concurrency for weak VPS.
APT_MIRROR=
NPM_REGISTRY=
