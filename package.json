{
  "name": "property-management-sys",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "typecheck": "pnpm --filter @cabin/api-contract run build && pnpm -r --if-present run typecheck",
    "typecheck:api": "pnpm --filter @cabin/api-contract run build && pnpm --filter @cabin/api run typecheck",
    "typecheck:pms": "pnpm --filter @cabin/api-contract run build && pnpm --filter @cabin/pms run typecheck",
    "typecheck:web": "pnpm --filter @cabin/web run typecheck",
    "typecheck:packages": "pnpm --filter @cabin/api-contract run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:ps": "docker compose ps",
    "prisma:generate": "pnpm --filter @cabin/api prisma:generate",
    "prisma:migrate": "pnpm --filter @cabin/api prisma:migrate",
    "prisma:seed": "pnpm --filter @cabin/api prisma:seed",
    "prisma:studio": "pnpm --filter @cabin/api prisma:studio"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^24.13.3",
    "husky": "^9.1.7",
    "typescript": "^5.8.3"
  }
}
