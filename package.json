{
  "name": "property-management-sys",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "typecheck": "pnpm --filter @cabin/api-contract run build && pnpm -r --if-present run typecheck",
    "typecheck:api": "pnpm --filter @cabin/api-contract run build && pnpm --filter @cabin/api run typecheck",
    "typecheck:pms": "pnpm --filter @cabin/api-contract run build && pnpm --filter @cabin/pms run typecheck",
    "typecheck:web": "pnpm --filter @cabin/web run typecheck",
    "typecheck:packages": "pnpm --filter @cabin/api-contract run typecheck && pnpm --filter @cabin/ui-tokens run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "db:up": "docker compose -f docker-compose.dev.yml up -d postgres",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:logs": "docker compose -f docker-compose.dev.yml logs -f postgres",
    "db:ps": "docker compose -f docker-compose.dev.yml ps",
    "archive:up": "docker compose -f docker-compose.dev.yml up -d garage archive-proxy",
    "archive:down": "docker compose -f docker-compose.dev.yml stop garage archive-proxy",
    "archive:logs": "docker compose -f docker-compose.dev.yml logs -f garage archive-proxy",
    "archive:bootstrap": "node --env-file=.env deploy/garage/bootstrap.mjs",
    "archive:bootstrap:vps": "bash deploy/garage/bootstrap-vps.sh",
    "logs:up": "docker compose -f docker-compose.dev.yml up -d loki",
    "logs:down": "docker compose -f docker-compose.dev.yml stop loki",
    "logs:logs": "docker compose -f docker-compose.dev.yml logs -f loki",
    "gotenberg:up": "docker compose -f docker-compose.dev.yml up -d gotenberg",
    "gotenberg:down": "docker compose -f docker-compose.dev.yml stop gotenberg",
    "prisma:generate": "pnpm --filter @cabin/api prisma:generate",
    "prisma:migrate": "pnpm --filter @cabin/api prisma:migrate",
    "prisma:seed": "pnpm --filter @cabin/api prisma:seed",
    "prisma:studio": "pnpm --filter @cabin/api prisma:studio",
    "ical:fixtures": "node scripts/ical-fixtures/serve.mjs",
    "ical:fixture:set": "node scripts/ical-fixtures/set-scenario.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^24.13.3",
    "husky": "^9.1.7",
    "typescript": "^5.8.3"
  }
}
